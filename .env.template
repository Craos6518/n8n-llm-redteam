# Automatización Low-Code - Variables de entorno
# Copia este archivo a .env y rellena tus valores reales
# NUNCA subas .env a control de versiones

# Discord Bot Token (obligatorio)
# Obténlo en https://discord.com/developers/applications
DISCORD_TOKEN=tu_token_aqui

# IDs de canales de Discord separados por comas donde el bot escuchará (obligatorio)
# Activa Modo Desarrollador en Discord -> clic derecho en canal -> Copiar ID
DISCORD_ALLOWED_CHANNELS=123456789012345678,987654321098765432

# URL del webhook de n8n (opcional, por defecto usa red interna Docker)
# Cambia solo si n8n está alojado fuera de esta red
N8N_WEBHOOK_URL=http://n8n:5678/webhook/redteam